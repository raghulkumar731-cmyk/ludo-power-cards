rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // players/{uid}
    // ------------------------------------------------------------------
    // Coins/gems/xp/wins/gamesPlayed/rankPoints/coinsToday/adsToday are now
    // ONLY ever written by the Cloud Functions in functions-anticheat-additions.js
    // (watchAdReward, buyShopCard, convertCoinsToGems, reportMatchResult), which run
    // with admin rights and are NOT subject to these rules at all. This block exists
    // to make sure nothing else — i.e. a player's own browser — can touch those fields.
    match /players/{uid} {
      allow read: if request.auth != null;

      // Account creation (signup): the client sets its OWN starting values, but every
      // currency/progress field must start at exactly zero — stops someone from
      // "creating" a profile with coins already set to a huge number.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins == 0
        && request.resource.data.xp == 0
        && request.resource.data.wins == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.rankPoints == 0;

      // Ongoing updates: only non-economy fields may change here. displayName/fullName/
      // updatedAt/loadout are harmless to self-edit. "equipped" stays client-writable
      // because switching between cards you ALREADY own costs nothing (see index.html's
      // free equip-toggle) — buyShopCard still writes it too, for the path that costs coins.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'fullName', 'equipped', 'loadout', 'updatedAt']);

      match /collection/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Idempotency records written by reportMatchResult — admin-only, never client-writable.
      match /claimedMatches/{matchId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ------------------------------------------------------------------
    // Unique display-name reservations
    // ------------------------------------------------------------------
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Everything else the game uses: unchanged from before
    // ------------------------------------------------------------------
    match /communityFeed/{doc}    { allow read, write: if request.auth != null; }
    match /matchQueue/{doc}       { allow read, write: if request.auth != null; }
    match /marketplaceCards/{doc} { allow read, write: if request.auth != null; }
    match /cardRequests/{doc}     { allow read, write: if request.auth != null; }
  }
}
