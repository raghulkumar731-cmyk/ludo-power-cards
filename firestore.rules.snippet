// MERGE these into your existing firestore.rules (do not replace the whole file blindly).
// Goal: players can never write their own `gems`, and nobody can touch `orders` from the browser.

match /players/{uid} {
  // keep your existing read/create/update conditions, and ADD the gems lock to update:
  allow update: if request.auth != null && request.auth.uid == uid
                && request.resource.data.gems == resource.data.gems;   // gems unchanged
  // on create, force gems to be absent or 0:
  allow create: if request.auth != null && request.auth.uid == uid
                && (!('gems' in request.resource.data) || request.resource.data.gems == 0);
}

match /orders/{orderId} {
  allow read, write: if false;   // only Cloud Functions (admin SDK) use this
}

// Card ideas the game could not build yet (so new rule blocks can be added). Players can only add, never read.
match /cardRequests/{id} {
  allow create: if request.auth != null;
  allow read, update, delete: if false;
}
match /aiUsage/{id} {
  allow read, write: if false;   // Cloud Functions only
}

// ---- Marketplace (gems) ----
// Listings and purchases are created ONLY by the publishMarketCard / buyMarketCard functions.
match /marketplaceCards/{id} {
  allow read: if request.auth != null;
  allow create, delete: if false;
  // keep your existing rule that lets players bump timesUsed / winCount (increments only), e.g.:
  // allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed','winCount']);
}
match /players/{uid}/collection/{cardId} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow delete: if request.auth != null && request.auth.uid == uid;
  allow create, update: if false;   // purchases are written by buyMarketCard
}
match /marketSales/{id} {
  allow read, write: if false;      // your sales ledger (read it in the Firebase console)
}
